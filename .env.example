# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=ai_document_rag
POSTGRES_PORT=5433

# Application Database Connection String
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password_here@localhost:5432/ai_document_rag

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_complex_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Embedding & Vector Storage
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_DIR=vector_store
VECTOR_COLLECTION_NAME=document_chunks

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_TIMEOUT_SECONDS=120
